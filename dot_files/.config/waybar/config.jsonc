{
    "layer": "top", 
    "position": "top", 
    "height": 30, 
    "spacing": 4, 
    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "custom/power"],

    // Sway Workspaces Module
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon} {name}",
        "format-icons": {
            "1": "💻",
            "2": "🌐",
            "3": "📝",
            "4": "🎵",
            "urgent": "⚠️",
            "focused": "",
            "default": ""
        }
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    // Clock (Time & Date combined)
    "clock": {
        "timezone": "auto",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "🕒 {:%H:%M}",
        "format-alt": "📅 {:%A, %B %d, %Y}"
    },

    // CPU Usage
    "cpu": {
        "interval":2,		// Force to refresh every 2 seconds
        "format": " {usage}%",
        "tooltip": true
    },

    // Memory Usage
    "memory": {
        "format": " {}%"
       
    },

    // Battery status
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    // Network Status
    "network": {
        "format-wifi": " {essid} ({signaldBm}dBm)",
        "format-ethernet": " {ipaddr}/{cidr}",
        "tooltip-format": " {ifname} via {gwaddr}",
        "format-linked": " {ifname} (No IP)",
        "format-disconnected": "⚠ Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    // Audio Controls (With visual spacing & Right-Click Mute)
    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-bluetooth": "{icon}   {volume}%  {format_source}",
        "format-bluetooth-muted": "   {icon} {format_source}",
        "format-muted": "   Muted",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    // Crash-Proof Power Menu (Uses stable Swaynag overlays)
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power Menu Options",
        "on-click": "swaynag -t warning -m 'Power Options Menu:' -b 'Logout' 'swaymsg exit' -b 'Reboot' 'systemctl reboot' -b 'Shutdown' 'systemctl poweroff' -b 'Switch User' 'dm-tool switch-to-greeter || loginctl lock-session'"
    }
}
