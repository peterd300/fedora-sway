{
    "layer": "top", 
    "position": "top", 
    "height": 30, 
    "spacing": 4, 
    "modules-left": ["sway/workspaces","sway/mode","sway/scratchpad"],
    "modules-center": [ "custom/updates","custom/theme-toggle","clock","custom/layout"],
    "modules-right": ["pulseaudio", "network","tray" , "cpu", "memory", "battery","custom/power"],

    // Sway Workspaces Module
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon} {name}",
        "format-icons": {
            "1": "💻",
            "2": "🌐",
            "3": "📝",
            "4": "🎵",
            "urgent": "⚠️",
            "focused": "",
            "default": ""
        }
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },


    "custom/layout": {
		"exec": "~/.config/waybar/layout.sh",
		"return-type": "json",
		"format": "{icon}",
		"format-icons": {
			"splith": "\uf0db",
			"splitv": "\uf0c9",
			"stacked": "\uf24d",
			"tabbed": "\uf2d0",
			"floating": "\uf2d2",
			"empty": "\uf10c"
			}
	},

    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    // Clock (Time & Date combined)
    "clock": {
    "timezone": "Europe/Amsterdam",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><span size='16pt'>{calendar}</span></tt>",
    "format": "🕒 {:%H:%M}",
    "format-alt": "📅 {:%A, %B %d, %Y}"
},

    // CPU Usage
    "cpu": {
        "interval":2,		// Force to refresh every 2 seconds
        "format": " {usage}%",
        "tooltip": true
    },

    // Memory Usage
    "memory": {
        "format": " {}%"
       
    },

    // Battery status
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    // Network Status
    "network": {
        "format-wifi": " {essid} ({signaldBm}dBm)",
        "format-ethernet": " {ipaddr}/{cidr}",
        "tooltip-format": " {ifname} via {gwaddr}",
        "format-linked": " {ifname} (No IP)",
        "format-disconnected": "⚠ Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        
    },
	
    // Audio Controls (With visual spacing & Right-Click Mute)
    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-bluetooth": "{icon}   {volume}%  {format_source}",
        "format-bluetooth-muted": "   {icon} {format_source}",
        "format-muted": "   Muted",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    },

    // Crash-Proof Power Menu (Uses stable Swaynag overlays)
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power Menu Options",
//     "on-click": "killall swaynag || true; swaynag -t warning -m 'Power Options Menu:' -b 'Logout' 'swaymsg exit' -b 'Reboot' 'systemctl reboot' -b 'Shutdown' 'systemctl poweroff' -b 'Switch User' 'dm-tool switch-to-greeter || loginctl lock-session'"
        "on-click": "wlogout",       
    },
    
    "tray": {
		"icon-size": 16,
		"spacing": 10
	},

	"custom/theme-toggle": {
	    "format": "{}",
	    "exec": "gsettings get org.gnome.desktop.interface color-scheme | grep -q 'dark' && echo '🌙' || echo '☀️'",
	    "interval": 2,
	    "on-click": "~/.local/bin/gtk-toggle-theme.sh",
	    "tooltip": true,
	    "tooltip-format": "Toggle Light/Dark Mode"
	},

       "custom/updates": {
		"format": "{}",
		"exec": "~/.local/bin/check-updates.sh",
		"return-type": "json",
		"interval": 3600,
		"signal": 8,
		"on-click": "foot sh -c 'sudo dnf upgrade; exec bash'"
}

	}
    

}

